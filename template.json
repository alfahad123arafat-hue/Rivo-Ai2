{
  "$schema": "https://railway.app/railway.schema.json",
  "name": "Rivo AI",
  "description": "Private self-hosted Qwen 3.5 chat assistant powered by Ollama.",
  "services": [
    {
      "name": "rivo-ai",
      "source": {
        "repo": "alfahad123arafat-hue/Rivo-Ai2",
        "branch": "arena/bc062ec5-rivo-ai2"
      },
      "variables": {
        "OLLAMA_MODEL": "qwen3.5:4b",
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "OLLAMA_NUM_CTX": "8192",
        "PORT": "8000",
        "STARTUP_RETRIES": "12",
        "STARTUP_RETRY_SECONDS": "10",
        "RATE_LIMIT_PER_MINUTE": "60"
      },
      "volumeMountPath": "/root/.ollama",
      "deploy": {
        "healthcheckPath": "/api/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      }
    }
  ]
}
